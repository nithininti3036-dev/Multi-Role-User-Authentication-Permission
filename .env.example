# ====================================================================
# RBAC Backend Environment Configuration
# ====================================================================

# Application
PROJECT_NAME="Multi-Role User Authentication & RBAC API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# JWT Security
SECRET_KEY="super-secret-jwt-key-change-this-in-production-1234567890"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration:
# By default, SQLite is enabled so you can run the project immediately with ZERO setup or installation!
# To use MySQL instead, comment out DATABASE_URL and fill in the MySQL settings below.
DATABASE_URL=sqlite:///./rbac.db

# MySQL Settings (Uncomment & configure if you install MySQL later)
# MYSQL_SERVER=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DB=rbac_db
USE_SQLITE_FALLBACK_ON_ERROR=True

# SuperAdmin Initial Seed Credentials
FIRST_SUPERADMIN_EMAIL=admin@example.com
FIRST_SUPERADMIN_PASSWORD=Admin@123456
FIRST_SUPERADMIN_USERNAME=superadmin
